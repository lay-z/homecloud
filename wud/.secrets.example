# Signs browser sessions. Generated by ./stack init; rotate to sign everyone out.
WUD_AUTH_SESSION_SECRET=

# Telegram alerts are opt-in. Append both lines with real values and run
# ./stack up; while they are absent no Telegram trigger is registered, so WUD
# never generates fake credentials or logs "chat not found".
#
# Bot token from @BotFather, chat ID from a message to the bot (see
# https://api.telegram.org/bot<token>/getUpdates after sending it /start).
# WUD_TRIGGER_TELEGRAM_NOTIFY_BOTTOKEN=
# WUD_TRIGGER_TELEGRAM_NOTIFY_CHATID=
