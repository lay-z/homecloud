# Registry check schedule. Hourly polling of every pinned image risks Docker Hub
# rate limits, so this checks every six hours by default.
#
# For a strictly weekly digest instead of near-real-time alerts, use
#   0 9 * * 1
# and set WUD_WATCHER_LOCAL_WATCHEVENTS=false so container restarts do not
# trigger an out-of-band check.
WUD_WATCHER_LOCAL_CRON=0 */6 * * *

# Report same-tag rebuilds. This is what catches the latest@sha256 and
# 16-alpine style pins in this repo, which have no semantic version to compare.
WUD_WATCHER_LOCAL_WATCHDIGESTDEFAULT=true
