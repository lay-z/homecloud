# Base domain without a scheme, path, or trailing slash.
BASE_DOMAIN=example.com

# Let's Encrypt account email.
ACME_EMAIL=admin@example.com

# Root directory for persistent service data. Must be outside this repo.
DATA_ROOT=/srv/stack

# Timezone.
TZ=UTC

# UID/GID for services that support it.
PUID=1000
PGID=1000

# Comma-separated service names. Traefik is always started.
ENABLED_SERVICES=jellyfin

# OIDC client shared by WUD and the authentik blueprint in authentik/blueprints.
# ./stack init generates these when they are empty; regenerate both together.
WUD_OIDC_CLIENT_ID=
WUD_OIDC_CLIENT_SECRET=
