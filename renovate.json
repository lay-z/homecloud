{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Asia/Kolkata)"
  ],
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Digest-only and patch updates arrive as one PR",
      "matchUpdateTypes": ["digest", "patch"],
      "groupName": "digest and patch updates"
    },
    {
      "description": "Minor updates arrive as their own PR",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor updates"
    },
    {
      "description": "Majors wait for a checkbox in the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
